<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_dim"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_transfer_container"
            android:elevation="16dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- 제목 + 닫기 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/pot"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/buttonClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_small_button"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/close"
                    android:scaleType="center"
                    android:src="@drawable/ic_close" />
            </FrameLayout>

            <!-- 팟 총액 -->
            <TextView
                android:id="@+id/textViewPotAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/chip_gold"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="125" />

            <!-- 베팅할 사람 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/bet_player"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerPlayer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewPlayerChips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="보내는 사람: 100개" />

                <TextView
                    android:id="@+id/textViewRoundBet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="이번 판: 25개" />
            </LinearLayout>

            <!-- 금액 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/amount"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editTextAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/amount_placeholder"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonQuick1"
                    style="@style/ChipTally.QuickAmount" />

                <Button
                    android:id="@+id/buttonQuick2"
                    style="@style/ChipTally.QuickAmount" />

                <Button
                    android:id="@+id/buttonQuick3"
                    style="@style/ChipTally.QuickAmount" />

                <Button
                    android:id="@+id/buttonAllIn"
                    style="@style/ChipTally.QuickAmount"
                    android:text="@string/all_in" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonBet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/place_bet"
                android:textAllCaps="false"
                android:textColor="@color/chip_cream"
                android:textSize="16sp"
                android:textStyle="bold" app:backgroundTint="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/rail_highlight" />

            <Button
                android:id="@+id/buttonTakePot"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_outline"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/take_pot"
                android:textAllCaps="false"
                android:textColor="@color/chip_cream"
                android:textSize="16sp"
                android:textStyle="bold" app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
